{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description} ${credits}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "${github_url}",
        "sources": "${github_url}",
        "issues": "${github_url}/issues"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
          "io.github.jason13official.player_item_descriptions.PlayerItemDescriptionsFabric"
        ],
      "client": [
        "io.github.jason13official.player_item_descriptions.PlayerItemDescriptionsClientFabric"
      ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  